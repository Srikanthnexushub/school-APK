<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="LOG_LEVEL_ROOT"  source="logging.level.root"           defaultValue="INFO"/>
    <springProperty scope="context" name="LOG_LEVEL_APP"   source="logging.level.com.edutech"     defaultValue="INFO"/>
    <springProperty scope="context" name="APP_NAME"        source="spring.application.name"        defaultValue="performance-svc"/>
    <springProperty scope="context" name="APP_ENV"         source="management.metrics.tags.environment" defaultValue="local"/>
    <springProperty scope="context" name="LOKI_URL"        source="loki.url"                       defaultValue="http://localhost:3100"/>
    <springProperty scope="context" name="LOG_DEDUP_REPS"  source="log.dedup.allowed-repetitions"  defaultValue="5"/>
    <springProperty scope="context" name="LOG_DEDUP_CACHE" source="log.dedup.cache-size"            defaultValue="500"/>

    <!-- ── Duplicate message rate-limiter (prevents log flooding) ──────────── -->
    <turboFilter class="ch.qos.logback.classic.turbo.DuplicateMessageFilter">
        <AllowedRepetitions>${LOG_DEDUP_REPS}</AllowedRepetitions>
        <CacheSize>${LOG_DEDUP_CACHE}</CacheSize>
    </turboFilter>

    <!-- ── Rolling file appender: max 10 MB per file, 50 MB total cap ─────── -->
    <!-- Older rotated files are gzip-compressed and auto-deleted once the     -->
    <!-- 50 MB totalSizeCap is reached. cleanHistoryOnStart prunes stale       -->
    <!-- rotated files from previous runs on every restart.                   -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/performance-svc.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/performance-svc.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [rid=%X{requestId}] [tid=%X{traceId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── Async wrapper: non-blocking writes, never blocks app threads ─────── -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <!-- ── Loki appender: push logs to Loki over HTTP ──────────────────────── -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${LOKI_URL}/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>service=${APP_NAME},environment=${APP_ENV},level=%level</pattern>
            </label>
            <message>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [rid=%X{requestId}] [tid=%X{traceId}] - %msg%n</pattern>
            </message>
            <sortByTime>true</sortByTime>
        </format>
    </appender>

    <!-- ── Development profile: human-readable console ─────────────────────── -->
    <springProfile name="local,dev">
        <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [rid=%X{requestId}] [tid=%X{traceId}] - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="${LOG_LEVEL_ROOT}">
            <appender-ref ref="CONSOLE_PLAIN"/>
            <appender-ref ref="LOKI"/>
        </root>
        <logger name="com.edutech" level="${LOG_LEVEL_APP}"/>
    </springProfile>

    <!-- ── Default / production profile: rolling file + Loki ──────────────── -->
    <springProfile name="!local &amp; !dev">
        <root level="${LOG_LEVEL_ROOT}">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="LOKI"/>
        </root>
        <logger name="com.edutech" level="${LOG_LEVEL_APP}"/>
    </springProfile>
</configuration>
